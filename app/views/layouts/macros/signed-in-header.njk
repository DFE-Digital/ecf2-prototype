{#
  GOV.UK header — logo only. Account info (school/org name, extra link, sign out)
  now renders in the service navigation bar via slots.end — see
  app/views/layouts/macros/nav-account-links.njk
#}
{% from "layouts/macros/dfe-header-logo.njk" import dfeHeaderLogo %}

{% macro signedInHeader(params) %}
  <div class="govuk-header govuk-header--full-width-border">
    <div class="govuk-header__container govuk-width-container">
      <div class="govuk-header__logo">
        {{ dfeHeaderLogo() }}
      </div>
    </div>
  </div>
{% endmacro %}
